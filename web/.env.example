# Copy to web/.env.local for local runs. Never commit .env.local.
# Base URL of the Taal API (docs/openapi.yaml). Default: http://localhost:8080
NEXT_PUBLIC_TAAL_API_URL=http://localhost:8080
# 1 = serve fixtures from web/mocks/*.json instead of calling the API (no backend needed)
NEXT_PUBLIC_TAAL_MOCK=1
