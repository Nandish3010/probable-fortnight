            { "value": "kirana", "label": "Kirana or independent store" },
            { "value": "supermarket_chain", "label": "Supermarket or retail chain" },
            { "value": "quick_commerce", "label": "Quick-commerce or dark stores" },
            { "value": "ecom_marketplace", "label": "E-commerce marketplace" },
            { "value": "distributor", "label": "Distributor or wholesaler" },
            { "value": "fmcg_brand", "label": "FMCG brand" },
            { "value": "other", "label": "Other" }
          ]
        },
        {
          "id": "a3_scale",
          "type": "single",
          "label": "How many locations does the business have?",
          "options": [
            { "value": "1", "label": "1 location" },
            { "value": "2_10", "label": "2–10" },
            { "value": "11_50", "label": "11–50" },
            { "value": "51_200", "label": "51–200" },
            { "value": "over_200", "label": "More than 200" }
