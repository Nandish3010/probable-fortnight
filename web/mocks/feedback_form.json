          "label": "Which best describes your role?",
          "other_id": "a1_role_other",
          "options": [
            { "value": "store_manager", "label": "Store or dark-store manager" },
            { "value": "category", "label": "Category or merchandising" },
            { "value": "supply_chain", "label": "Supply chain or inventory planning" },
            { "value": "ecom_qcom_ops", "label": "E-commerce or quick-commerce operations" },
            { "value": "owner", "label": "Owner or founder" },
            { "value": "other", "label": "Other" }
          ]
        },
        {
          "id": "a2_business",
          "type": "single",
