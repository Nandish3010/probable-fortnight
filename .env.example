# Copy to .env for local runs. Never commit .env.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
TAAL_MODEL_BACKEND=stub          # stub | vertex
TAAL_TENANT_CONFIG=config/tenant.demo.toml
TAAL_DATA_DIR=.local/data        # local file store standing in for Firestore/BigQuery
TAAL_API_URL=http://localhost:8080
TAAL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # CORS allowlist; add the deployed taal-web origin(s) in production
