{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/customer.record_stop.schema.json",
  "title": "customer.record_stop",
  "description": "Contract for the customer agent tool `record_stop`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "channel"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        }
      }
    }
  }
}
