{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/planner.estimate_outcomes.schema.json",
  "title": "planner.estimate_outcomes",
  "description": "Contract for the planner agent tool `estimate_outcomes`. Tools are deterministic Python or store reads; no LLM inside. Batched: one call estimates every candidate draft, saving the round trips a call-per-candidate used to cost.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_drafts"
      ],
      "properties": {
        "play_drafts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "expected_outcome",
          "counterfactuals"
        ],
        "properties": {
          "expected_outcome": {
            "type": "object"
          },
          "counterfactuals": {
            "type": "object"
          },
          "choice_index": {
            "type": "integer",
            "description": "Position of the draft; propose_play(choice_index=...) takes it."
          },
          "gate": {
            "type": "object",
            "description": "What propose_play's gate would say about this draft: the eight guardrails and beats_markdown.",
            "required": [
              "accepted_by_gate",
              "guardrails_all_passed",
              "failed_rules",
              "beats_markdown"
            ],
            "properties": {
              "accepted_by_gate": {
                "type": "boolean"
              },
              "guardrails_all_passed": {
                "type": "boolean"
              },
              "failed_rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "rule",
                    "detail"
                  ]
                }
              },
              "beats_markdown": {
                "type": "object",
                "required": [
                  "passed",
                  "detail"
                ]
              }
            }
          },
          "reach": {
            "type": "object",
            "description": "Consented customers in this draft versus all reachable (absent for a markdown).",
            "properties": {
              "consented_customers_in_this_draft": {
                "type": "integer"
              },
              "consented_customers_if_all_segments_included": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
