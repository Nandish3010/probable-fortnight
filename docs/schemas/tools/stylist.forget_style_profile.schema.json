{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/stylist.forget_style_profile.schema.json",
  "title": "stylist.forget_style_profile",
  "description": "Withdraw the style_profile consent row and delete the customer's saved skin-tone profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["customer_id"],
      "properties": { "customer_id": { "type": "string" } }
    },
    "output": {
      "type": "object", "required": ["ok"],
      "properties": { "ok": { "type": "boolean" } }
    }
  }
}
