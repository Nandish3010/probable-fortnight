{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/customer.get_stock.schema.json",
  "title": "customer.get_stock",
  "description": "Contract for the customer agent tool `get_stock`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "node_id"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "sku",
        "node_id",
        "availability",
        "online_sellby_date",
        "expiry_date"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": [
            "in_stock",
            "few_left",
            "out_of_stock"
          ]
        },
        "online_sellby_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiry_date": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
