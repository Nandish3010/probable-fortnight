{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/customer.find_substitutes.schema.json",
  "title": "customer.find_substitutes",
  "description": "Contract for the customer agent tool `find_substitutes`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "node_id"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "name",
          "qty"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          }
        }
      }
    }
  }
}
