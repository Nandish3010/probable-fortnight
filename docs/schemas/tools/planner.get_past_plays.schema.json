{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/planner.get_past_plays.schema.json",
  "title": "planner.get_past_plays",
  "description": "Contract for the planner agent tool `get_past_plays`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "category",
        "mechanic"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "mechanic": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "play_id",
          "mechanic",
          "status"
        ],
        "properties": {
          "play_id": {
            "type": "string"
          },
          "mechanic": {
            "type": "string"
          },
          "mechanic_params": {
            "type": "object"
          },
          "expected_units": {
            "type": "number"
          },
          "measured_units": {
            "type": [
              "number",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
