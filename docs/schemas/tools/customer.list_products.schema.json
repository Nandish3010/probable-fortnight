{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/customer.list_products.schema.json",
  "title": "customer.list_products",
  "description": "Browse in-stock products at the customer's node by name or category words; empty query returns the categories on the shelf.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "query",
        "node_id"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "node_id": {
          "type": "string",
          "description": "The customer's home node id, exactly as returned by get_customer_context/get_style_context (field home_node_id) -- never invent one. A node id that does not exist falls back to the customer's real home node server-side."
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "query",
        "node_id",
        "categories",
        "products"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "products": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "sku",
              "name",
              "category",
              "availability",
              "list_price"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "availability": {
                "type": "string",
                "enum": [
                  "in_stock",
                  "few_left",
                  "out_of_stock"
                ]
              },
              "list_price": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
