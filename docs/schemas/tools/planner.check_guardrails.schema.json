{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/planner.check_guardrails.schema.json",
  "title": "planner.check_guardrails",
  "description": "Contract for the planner agent tool `check_guardrails`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_draft"
      ],
      "properties": {
        "play_draft": {
          "type": "object"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "results",
        "all_passed"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "passed",
              "detail"
            ]
          }
        },
        "all_passed": {
          "type": "boolean"
        }
      }
    }
  }
}
