{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/stylist.get_style_context.schema.json",
  "title": "stylist.get_style_context",
  "description": "Home node, language, past style asks and the customer's own confirmed skin-tone profile, if any. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "output"],
  "properties": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["customer_id"],
      "properties": { "customer_id": { "type": "string" } }
    },
    "output": {
      "type": "object",
      "required": ["customer_id", "home_node_id", "language", "recent_asks"],
      "properties": {
        "customer_id": { "type": "string" },
        "home_node_id": { "type": "string" },
        "language": { "type": "string" },
        "display_name": { "type": ["string", "null"] },
        "recent_asks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["times_asked", "last_asked_at", "fulfilled"],
            "properties": {
              "garment_type": { "type": ["string", "null"] },
              "colour_family": { "type": ["string", "null"] },
              "occasion": { "type": ["string", "null"] },
              "times_asked": { "type": "integer", "minimum": 1 },
              "last_asked_at": { "type": "string" },
              "fulfilled": { "type": "boolean" }
            }
          }
        },
        "style_profile": {
          "type": ["object", "null"],
          "properties": {
            "undertone": { "type": "string", "enum": ["warm", "cool", "neutral"] },
            "depth": { "type": "string", "enum": ["light", "medium", "deep"] },
            "source": { "type": "string", "enum": ["declared", "selfie"] },
            "confirmed": { "type": "boolean" }
          }
        }
      }
    }
  }
}
