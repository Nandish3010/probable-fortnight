{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/customer.apply_offer.schema.json",
  "title": "customer.apply_offer",
  "description": "Contract for the customer agent tool `apply_offer`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_id",
        "customer_id"
      ],
      "properties": {
        "play_id": {
          "type": "string"
        },
        "customer_id": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "ok",
        "reason"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "applied",
            "not_treated",
            "no_consent",
            "frequency_cap",
            "margin_floor",
            "expired",
            "unknown_play"
          ]
        },
        "discount_pct": {
          "type": "number"
        }
      }
    }
  }
}
