{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/stylist.place_order.schema.json",
  "title": "stylist.place_order",
  "description": "Contract for the stylist agent tool `place_order`. Goes through the same MCP order mock the grocery Customer Agent uses (agents/mcp_orders/server.py); play_id is optional -- a walk-in apparel purchase with no play still places an order at list price. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id",
        "node_id",
        "lines"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "node_id": {
          "type": "string"
        },
        "lines": {
          "type": "array"
        },
        "play_id": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "order_id",
        "total_inr"
      ],
      "properties": {
        "order_id": {
          "type": "string"
        },
        "total_inr": {
          "type": "number"
        },
        "error": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sku",
              "name",
              "qty",
              "price",
              "discount"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "qty": {
                "type": "integer"
              },
              "price": {
                "type": "number"
              },
              "discount": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
