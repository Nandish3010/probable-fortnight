{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/customer.get_customer_context.schema.json",
  "title": "customer.get_customer_context",
  "description": "Contract for the customer agent tool `get_customer_context`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_id"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "customer_id",
        "home_node_id",
        "language",
        "pending_offers",
        "arms",
        "consent_marketing"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "home_node_id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "pending_offers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "play_id",
              "text",
              "best_before_date"
            ],
            "properties": {
              "play_id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "best_before_date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "arms": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "treated",
              "holdout"
            ]
          }
        },
        "consent_marketing": {
          "type": "boolean"
        },
        "memory": {
          "type": "array",
          "description": "This customer's own unmet requests, across every past session, oldest first filtered out: what they asked for that was out of stock or unmatched, how many times, and whether it is in stock now.",
          "items": {
            "type": "object",
            "required": [
              "request_type",
              "times_asked",
              "last_asked_at"
            ],
            "properties": {
              "sku": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "query_text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "request_type": {
                "type": "string",
                "enum": [
                  "out_of_stock",
                  "no_match"
                ]
              },
              "times_asked": {
                "type": "integer",
                "minimum": 1
              },
              "last_asked_at": {
                "type": "string"
              },
              "now_in_stock": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
