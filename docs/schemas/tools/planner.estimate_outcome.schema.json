{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/planner.estimate_outcome.schema.json",
  "title": "planner.estimate_outcome",
  "description": "Contract for the planner agent tool `estimate_outcome`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_draft"
      ],
      "properties": {
        "play_draft": {
          "type": "object"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "expected_outcome",
        "counterfactuals"
      ],
      "properties": {
        "expected_outcome": {
          "type": "object"
        },
        "counterfactuals": {
          "type": "object"
        }
      }
    }
  }
}
