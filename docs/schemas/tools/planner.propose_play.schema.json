{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/planner.propose_play.schema.json",
  "title": "planner.propose_play",
  "description": "Contract for the planner agent tool `propose_play`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play"
      ],
      "properties": {
        "play": {
          "type": "object"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "play_id",
        "valid",
        "errors"
      ],
      "properties": {
        "play_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
