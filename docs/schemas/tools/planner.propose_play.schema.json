{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/tools/planner.propose_play.schema.json",
  "title": "planner.propose_play",
  "description": "Contract for the planner agent tool `propose_play`. Tools are deterministic Python or store reads; no LLM inside.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "description": "Either the full `play` (the original path) or `choice_index`: the position of one result of the latest estimate_outcomes call; the play is then assembled from that estimated draft.",
      "anyOf": [
        {
          "required": [
            "play"
          ]
        },
        {
          "required": [
            "choice_index"
          ]
        }
      ],
      "properties": {
        "play": {
          "type": "object"
        },
        "choice_index": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string",
          "description": "Optional, with choice_index: one or two sentences appended to the assembled rationale; any number in it must be cited."
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "play_id",
        "valid",
        "errors"
      ],
      "properties": {
        "play_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
