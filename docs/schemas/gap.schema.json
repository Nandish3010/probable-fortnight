{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taal.example/schemas/gap.schema.json",
  "title": "Gap",
  "type": "object",
  "required": [
    "gap_id",
    "type",
    "sku",
    "node_id",
    "units_at_risk",
    "deadline_date",
    "deadline_type",
    "rupees_at_stake",
    "evidence"
  ],
  "properties": {
    "gap_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "online_sellby_breach",
        "expiry_writeoff",
        "stockout_risk",
        "rebalance",
        "slow_mover",
        "unmet_demand",
        "assortment_gap"
      ]
    },
    "sku": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "units_at_risk": {
      "type": "integer"
    },
    "deadline_date": {
      "type": "string",
      "format": "date"
    },
    "deadline_type": {
      "type": "string",
      "enum": [
        "online_sellby",
        "expiry",
        "lead_time"
      ]
    },
    "rupees_at_stake": {
      "type": "number"
    },
    "evidence": {
      "type": "object",
      "required": [
        "on_hand",
        "projected_sellthrough",
        "forecast_run_id",
        "sellby_rule"
      ],
      "properties": {
        "on_hand": {
          "type": "integer"
        },
        "projected_sellthrough": {
          "type": "number"
        },
        "forecast_run_id": {
          "type": "string"
        },
        "sellby_rule": {
          "type": "string"
        },
        "inbound": {
          "type": "integer"
        },
        "unit_cost": {
          "type": "number"
        },
        "margin_per_unit": {
          "type": "number"
        },
        "requests_count": {
          "type": "integer",
          "description": "Rows in customer_requests (or style_requests, for assortment_gap) behind this gap or its enrichment; a repeat ask from the same customer counts again."
        },
        "distinct_customers": {
          "type": "integer"
        },
        "requesting_customer_ids": {
          "type": "array",
          "items": {"type": "string"},
          "description": "assortment_gap only: the real customer_ids behind this demand signal, so the Planner can target them directly when no affinity-table coverage exists for the sku (apparel is not in the grocery affinity table)."
        },
        "supply_node_id": {
          "type": ["string", "null"],
          "description": "assortment_gap only: the other node that actually carries the resolved sku, if any -- the transfer_plus_nudge target."
        },
        "garment_type": {
          "type": "string",
          "description": "assortment_gap only: the garment type behind the demand signal (from style_requests)."
        },
        "colour_family": {
          "type": "string",
          "description": "assortment_gap only: the colour-wheel family behind the demand signal (agents/stylist/colour.py)."
        }
      }
    }
  }
}
