# taal-agents / taal-sense image: ADK service and the nightly Sense job share this image
# (DECISIONS §4.1); the Cloud Run service runs uvicorn, the Cloud Run Job overrides the command
# to `python -m jobs.sense`.
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN uv sync --frozen --no-dev

# Seed the demo tenant into the image (mirrors `make generate`). .local/ is dockerignored and the
# API never generates data at startup, so without this the container serves an empty tenant:
# /health degraded with 0 SKUs, /gaps and /plays [], /sense/last 404. Stub backend here on
# purpose -- the seeded plays are the golden fixtures; the vertex backend is a runtime setting.
ENV TAAL_DATA_DIR=/app/.local/data \
    TAAL_TENANT_CONFIG=config/tenant.demo.toml
RUN TAAL_MODEL_BACKEND=stub uv run python -m data.generator --out /app/.local/data --seed 20260912 \
 && TAAL_MODEL_BACKEND=stub uv run python -m jobs.sense \
 && TAAL_MODEL_BACKEND=stub uv run python -m harness.seed_plays

ENV PORT=8080
EXPOSE 8080

CMD ["sh", "-c", "uv run uvicorn services.api.main:app --host 0.0.0.0 --port ${PORT}"]
